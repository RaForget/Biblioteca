{
  "info": {
    "name": "Biblioteca - APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Leia docs/APIS.md. Preencha accessToken localmente com o JWT do login web. A criacao de emprestimo altera dados. Nao repita POST automaticamente."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "apiUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "notificationsUrl",
      "value": "http://localhost:8004"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "bookId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "traceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Saude da API",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{apiUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Saude das notificacoes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{notificationsUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Catalogo publico (salva bookId)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{apiUrl}}/books",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const books = pm.response.json(); if (books.length) pm.collectionVariables.set(\"bookId\", books[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Emprestimos sem token: 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{apiUrl}}/loans",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Criar emprestimo autenticado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/loans",
        "body": {
          "mode": "raw",
          "raw": "{\"bookId\": \"{{bookId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"loanId\", pm.response.json().id); pm.collectionVariables.set(\"traceId\", pm.response.headers.get(\"X-Trace-Id\") || \"\"); }"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Consultar emprestimos autenticados",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{apiUrl}}/loans"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Consultar notificacoes autenticadas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{notificationsUrl}}/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Rejeitar identidade no body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/loans",
        "body": {
          "mode": "raw",
          "raw": "{\"bookId\": \"{{bookId}}\", \"readerName\": \"Outro leitor\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Livro inexistente: 404",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/loans",
        "body": {
          "mode": "raw",
          "raw": "{\"bookId\": \"00000000-0000-4000-8000-000000000000\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status esperado\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
